# Coolify deployment environment variables for Cal.diy
# Set these in the Coolify UI. Do not commit real secrets to git.

# - PUBLIC URLS *********************************************************************************
NEXT_PUBLIC_WEBAPP_URL="https://cal.jasperfilmz.online"
NEXTAUTH_URL="https://cal.jasperfilmz.online/api/auth"
NEXT_PUBLIC_API_V2_URL="https://api.cal.jasperfilmz.online/api/v2"
API_URL="https://api.cal.jasperfilmz.online"
WEB_APP_URL="https://cal.jasperfilmz.online"

# Define which hostnames are expected for the app to work on
ALLOWED_HOSTNAMES='"cal.jasperfilmz.online","api.cal.jasperfilmz.online"'

# - AUTHENTICATION ********************************************************************************
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="changeme_openssl_rand_base64_32"

# Generate with: openssl rand -base64 24
CALENDSO_ENCRYPTION_KEY="changeme_openssl_rand_base64_24"

# - DATABASE **************************************************************************************
POSTGRES_USER="calcom"
POSTGRES_PASSWORD="changeme_secure_random_password"
POSTGRES_DB="calendso"
DATABASE_URL="postgresql://calcom:changeme_secure_random_password@database:5432/calendso"
DATABASE_DIRECT_URL="postgresql://calcom:changeme_secure_random_password@database:5432/calendso"

# - API V2 ***************************************************************************************
# Generate with: openssl rand -base64 32
JWT_SECRET="changeme_openssl_rand_base64_32"
REDIS_URL="redis://redis:6379"

# - OPTIONAL *************************************************************************************
CALCOM_TELEMETRY_DISABLED="1"
CSP_POLICY="non-strict"
NODE_ENV="production"
API_PORT="5555"
REWRITE_API_V2_PREFIX="1"
